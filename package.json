    "bin/jdi-uninstall.sh",
    "bin/jdi-uninstall.ps1",
    "bin/jdi-doctor.sh",
    "bin/jdi-doctor.ps1",
    "bin/git-hooks",
    "core",
    "runtimes",
    "templates-jdi-folder",
    "README.md",
    "ARCHITECTURE.md",
