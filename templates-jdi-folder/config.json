{
  "$schema_version": "1.3",
  "budgets": {
    "context_tokens": 10000,
    "plan_tokens": 12000,
    "summary_tokens": 3000,
    "review_segment_tokens": 6000,
    "brief_tokens": 6000,
    "known_errors_query_tokens": 2000,
    "verify_inline_chars": 300,
    "phase_extra_file_kb": 50,
    "enforce": "warn"
  },
  "chars_per_token": {
    "pt-BR": 2.2,
    "en": 3.2
  },
  "models": {
    "asker": "inherit",
    "planner": "inherit",
    "doer": "inherit",
    "reviewer": "inherit",
    "critic": "inherit"
  },
  "compaction": {
    "archive_after": 5
  },
  "orchestration": {
    "mode": "standard",
    "source": "default"
  },
  "gate": {
    "code_globs": ["src/**"]
  },
  "coverage_min": 80
}
