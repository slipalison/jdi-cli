{
  "$schema_version": "1",
  "name": "example-backend",
  "agent": "jdi-reviewer-example-backend",
  "file_glob": ["backend/**"],
  "shell": "bash",
  "env": {
    "CI": "1"
  },
  "path_prepend": ["~/.cargo/bin"],
  "gates": {
    "build": "cargo build --manifest-path backend/Cargo.toml",
    "test": "cargo test --manifest-path backend/Cargo.toml",
    "coverage": "cargo llvm-cov --manifest-path backend/Cargo.toml --fail-under-lines 80",
    "lint": "cargo clippy --manifest-path backend/Cargo.toml -- -D warnings",
    "audit": "cargo audit --file backend/Cargo.lock"
  },
  "test_report": ["backend/target/nextest/ci/junit.xml"],
  "requires": {
    "env": [],
    "commands": ["cargo"],
    "disk_free_mb": 2048
  },
  "coverage_runs_tests": true,
  "lint_blocks": false,
  "timeout_min": 30,
  "cache_key_cmd": "rustc -V && cargo -V",
  "evidence_only": ["npm run e2e", "playwright test"]
}
